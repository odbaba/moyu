// ============================================================
// frame_34/DoAction.as - 地图场景
// ============================================================
// 功能说明：
// 本文件是地图的场景初始化脚本
// 
// 主要功能：
// 1. 设置角色位置
// 2. 标记为安全区域（danger = false 表示无怪物）
// 
// 场景设置：
// - renwu: MovieClip - 角色显示对象
// - renwu._x = 190 - 角色X坐标
// - renwu._y = 245 - 角色Y坐标
// 
// 地图属性：
// - 地图类型：安全区域（无怪物）
// - danger = false - 标记为安全区域
// 
// 相关文件：
// - frame_6/DoAction.as - 核心游戏逻辑
// ============================================================

stop();

// 设置角色X坐标位置
renwu._x = 190;

// 设置角色Y坐标位置
renwu._y = 245;

// 标记为安全区域（无怪物）
danger = false;
