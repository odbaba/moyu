// ============================================================
// frame_5/DoAction.as - 开始游戏判断
// ============================================================
// 功能说明：
// 本文件负责判断是开始新游戏还是继续游戏
// 
// 主要功能：
// 1. 设置新游戏标记为false
// 2. 跳转到"开始"帧并开始播放
// 
// 调用关系：
// - 被 frame_4 调用（玩家名称输入完成后）
// - 跳转到 frame_6（核心游戏逻辑）
// 
// 注意：
// - _root.newgame 在 frame_4 中被设置为 true
// - 此处设置为 false 表示新游戏流程结束
// ============================================================

// 标记新游戏流程结束
_root.newgame = false;

// 跳转到"开始"帧（对应 frame_6）
gotoAndStop("开始");

// 开始播放时间轴
play();
