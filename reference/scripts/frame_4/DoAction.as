// ============================================================
// frame_4/DoAction.as - 玩家名称输入界面
// ============================================================
// 功能说明：
// 本文件是游戏开始时的玩家名称输入界面
// 玩家可以在此输入自己的角色名称
// 
// 主要功能：
// 1. 设置默认玩家名称为"魔域玩家"
// 2. 自动聚焦到名称输入框
// 3. 标记为新游戏模式
// 
// 界面元素：
// - player_name: TextInput - 玩家名称输入框
// 
// 调用关系：
// - 被 frame_3 调用（游戏初始化后）
// - 跳转到 frame_5（开始游戏判断）
// ============================================================

stop();

// 设置默认玩家名称
player_name.text = "魔域玩家";

// 设置输入焦点到名称输入框
Selection.setFocus("_root.player_name");

// 选中输入框中的所有文本（方便用户直接输入）
Selection.setSelection(0, 0);

// 标记为新游戏模式
_root.newgame = true;
