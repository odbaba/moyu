// ============================================================
// frame_11/DoAction.as - 卡萨诺城地图场景
// ============================================================
// 功能说明：
// 本文件是卡萨诺城地图的场景初始化脚本
// 卡萨诺城是游戏中的主要城市，安全区域
// 
// 主要功能：
// 1. 设置角色位置
// 2. 标记为安全区域（danger = false 表示无怪物）
// 3. 首次进入时显示剧情提示
// 
// 场景设置：
// - renwu: MovieClip - 角色显示对象
// - renwu._x = 345 - 角色X坐标
// - renwu._y = 333 - 角色Y坐标
// 
// 地图属性：
// - 地图名称：卡萨诺城
// - 地图类型：安全区域（无怪物）
// - danger = false - 标记为安全区域
// 
// 剧情说明：
// 首次进入时，玩家会看到可爱的娃娃
// 
// 相关文件：
// - frame_6/DoAction.as - 核心游戏逻辑
// ============================================================

stop();

// 设置角色X坐标位置
renwu._x = 345;

// 设置角色Y坐标位置
renwu._y = 333;

// 标记为安全区域（无怪物）
danger = false;

// 检查是否首次进入
if(nowmap != "卡萨诺城")
{
   // 首次进入，显示剧情提示
   _root.alertbox("　　经过一番努力，终于看到了一只可爱的娃娃........");
   // 更新当前地图名称
   _root.nowmap = "卡萨诺城";
}
else
{
   // 非首次进入，直接跳转到当前地图
   gotoAndStop(nowmap);
}
