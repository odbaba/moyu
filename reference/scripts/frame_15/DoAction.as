// ============================================================
// frame_15/DoAction.as - 抽奖房地图场景
// ============================================================
// 功能说明：
// 本文件是抽奖房地图的场景初始化脚本
// 抽奖房是游戏中的特殊功能区域，玩家可以在此进行抽奖
// 
// 主要功能：
// 1. 设置角色位置
// 2. 标记为安全区域（danger = false 表示无怪物）
// 3. 设置当前地图名称
// 
// 场景设置：
// - renwu: MovieClip - 角色显示对象
// - renwu._x = 345 - 角色X坐标
// - renwu._y = 315 - 角色Y坐标
// 
// 地图属性：
// - 地图名称：抽奖房
// - 地图类型：安全区域（无怪物）
// - danger = false - 标记为安全区域
// 
// 相关功能：
// - 抽奖系统：玩家可以花费魔石进行抽奖
// 
// 相关文件：
// - frame_6/DoAction.as - 核心游戏逻辑
// ============================================================

stop();

// 设置当前地图名称
_root.nowmap = "抽奖房";

// 设置角色X坐标位置
renwu._x = 345;

// 设置角色Y坐标位置
renwu._y = 315;

// 标记为安全区域（无怪物）
danger = false;
