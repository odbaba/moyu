// ============================================================
// frame_28/DoAction.as - 地下城1层地图场景
// ============================================================
// 功能说明：
// 本文件是地下城1层地图的场景初始化脚本
// 地下城是游戏中的高级副本区域，有强力怪物和丰厚奖励
// 
// 主要功能：
// 1. 设置角色位置
// 2. 标记为危险区域（danger = true 表示有怪物）
// 3. 设置当前地图名称
// 4. 检查并完成地下城任务
// 
// 场景设置：
// - renwu: MovieClip - 角色显示对象
// - renwu._x = 320 - 角色X坐标
// - renwu._y = 315 - 角色Y坐标
// 
// 地图属性：
// - 地图名称：地下城1层
// - 地图类型：危险区域（有强力怪物）
// - danger = true - 标记为危险区域
// 
// 任务系统：
// - 当所有地下城1层怪物任务完成时，给予奖励
// - 奖励：灵魂王道具 + 3000功勋
// - 完成后可以进入地下城2层
// 
// 任务变量：
// - rw_gw1_1: 地下城1层怪物1任务
// - rw_gw1_2: 地下城1层怪物2任务
// - rw_gw1_3: 地下城1层怪物3任务
// 
// 相关文件：
// - frame_6/DoAction.as - 核心游戏逻辑
// - frame_29/DoAction.as - 地下城2层
// - frame_30/DoAction.as - 地下城3层
// ============================================================

stop();

// 检查是否完成地下城1层任务
if(!rw_gw1_1 && !rw_gw1_2 && !rw_gw1_3 && _root.nowmap == "地下城1层")
{
   // 所有怪物已击败，给予奖励
   id = "灵魂王";
   
   // 添加道具到背包
   _root.beibao.more(this);
   
   // 奖励功勋值
   var exps = 3000;
   _root.xinxi.upjw(exps);
   
   // 显示完成提示
   _root.alertbox("\r你完成了第一层任务：获得了" + id + "和3,000功勋。" + "\n" + "现在可以进入第二层了。");
}

// 标记为危险区域（有怪物）
danger = true;

// 设置当前地图名称
_root.nowmap = "地下城1层";

// 设置角色X坐标位置
renwu._x = 320;

// 设置角色Y坐标位置
renwu._y = 315;
