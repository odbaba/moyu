// ============================================================
// frame_35/DoAction.as - 树心城地图场景
// ============================================================
// 功能说明：
// 本文件是树心城地图的场景初始化脚本
// 树心城是游戏中的主要城市，安全区域
// 
// 主要功能：
// 1. 设置角色位置
// 2. 标记为安全区域（danger = false 表示无怪物）
// 3. 设置当前地图名称
// 
// 场景设置：
// - renwu: MovieClip - 角色显示对象
// - renwu._x = 235 - 角色X坐标
// - renwu._y = 310 - 角色Y坐标
// 
// 地图属性：
// - 地图名称：树心城
// - 地图类型：安全区域（无怪物）
// - danger = false - 标记为安全区域
// 
// 相关NPC：
// - 商人、仓库管理员等
// 
// 相关文件：
// - frame_6/DoAction.as - 核心游戏逻辑
// ============================================================

stop();

// 设置角色X坐标位置
renwu._x = 235;

// 设置角色Y坐标位置
renwu._y = 310;

// 标记为安全区域（无怪物）
danger = false;

// 设置当前地图名称
_root.nowmap = "树心城";
