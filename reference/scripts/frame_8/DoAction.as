// ============================================================
// frame_8/DoAction.as - 雷鸣大陆地图场景
// ============================================================
// 功能说明：
// 本文件是雷鸣大陆地图的场景初始化脚本
// 雷鸣大陆是游戏的起始地图，也是主要的安全区域
// 
// 主要功能：
// 1. 设置角色位置
// 2. 标记为危险区域（danger = true 表示有怪物）
// 
// 场景设置：
// - renwu: MovieClip - 角色显示对象
// - renwu._x = 313 - 角色X坐标
// - renwu._y = 323 - 角色Y坐标
// 
// 地图属性：
// - 地图名称：雷鸣大陆
// - 地图类型：安全区域（有怪物但较弱）
// - danger = true - 标记为危险区域
// 
// 调用关系：
// - 被 frame_6 调用（游戏初始化时跳转）
// - 可从其他地图切换到此地图
// 
// 相关NPC：
// - 商人、仓库管理员、装备商等
// 
// 相关文件：
// - frame_6/DoAction.as - 核心游戏逻辑
// - DefineSprite_1071 - 地图切换按钮
// - DefineSprite_1074 - 怪物选择按钮
// ============================================================

stop();

// 设置角色X坐标位置
renwu._x = 313;

// 设置角色Y坐标位置
renwu._y = 323;

// 标记为危险区域（有怪物）
danger = true;
