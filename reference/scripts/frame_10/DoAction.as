// ============================================================
// frame_10/DoAction.as - 草原2地图场景
// ============================================================
// 功能说明：
// 本文件是草原2地图的场景初始化脚本
// 这是游戏中的一个野外地图，有怪物出没
// 
// 主要功能：
// 1. 设置角色位置
// 2. 标记为危险区域（danger = true 表示有怪物）
// 3. 首次进入时显示剧情提示
// 
// 场景设置：
// - renwu: MovieClip - 角色显示对象
// - renwu._x = 180 - 角色X坐标
// - renwu._y = 380 - 角色Y坐标
// 
// 地图属性：
// - 地图名称：草原2
// - 地图类型：野外区域（有怪物）
// - danger = true - 标记为危险区域
// 
// 剧情说明：
// 首次进入时，玩家会遇到怪兽
// 
// 相关文件：
// - frame_6/DoAction.as - 核心游戏逻辑
// ============================================================

stop();

// 设置角色X坐标位置
renwu._x = 180;

// 设置角色Y坐标位置
renwu._y = 380;

// 标记为危险区域（有怪物）
danger = true;

// 检查是否首次进入
if(nowmap != "雷鸣矿洞" && nowmap != "草原2")
{
   // 首次进入，显示剧情提示
   _root.alertbox("　　你找啊找，来到了一片草原上，突然蹦出了一头怪兽出来...非常凶悍...是打是跑你看着办吧...");
   // 更新当前地图名称
   _root.nowmap = "草原2";
}
else
{
   // 非首次进入，直接跳转到当前地图
   gotoAndStop(nowmap);
}
