// ============================================================
// frame_29/DoAction.as - 地下城2层地图场景
// ============================================================
// 功能说明：
// 本文件是地下城2层地图的场景初始化脚本
// 地下城2层是游戏中的高级副本区域，有更强力的怪物
// 
// 主要功能：
// 1. 设置角色位置
// 2. 标记为危险区域（danger = true 表示有怪物）
// 3. 设置当前地图名称
// 4. 检查并完成地下城2层任务
// 
// 场景设置：
// - renwu: MovieClip - 角色显示对象
// - renwu._x = 140 - 角色X坐标
// - renwu._y = 470 - 角色Y坐标
// 
// 地图属性：
// - 地图名称：地下城2层
// - 地图类型：危险区域（有强力怪物）
// - danger = true - 标记为危险区域
// 
// 任务系统：
// - 当所有地下城2层怪物任务完成时，给予奖励
// - 奖励：6000功勋 + 极品一洞+9装备一件
// - 完成后可以进入地下城3层
// 
// 任务变量：
// - rw_gw2_1: 地下城2层怪物1任务
// - rw_gw2_2: 地下城2层怪物2任务
// 
// 相关文件：
// - frame_6/DoAction.as - 核心游戏逻辑
// - frame_28/DoAction.as - 地下城1层
// - frame_30/DoAction.as - 地下城3层
// ============================================================

stop();

// 检查是否完成地下城2层任务
if(!rw_gw2_1 && !rw_gw2_2 && _root.nowmap == "地下城2层")
{
   // 所有怪物已击败，给予奖励
   var exps = 6000;
   
   // 增加功勋值
   _root.xinxi.upjw(exps);
   
   // 生成极品一洞+9装备
   weapon(4,9,1);
   
   // 显示完成提示
   _root.alertbox("\r你完成了第一层任务：获得了6,000功勋和极品一洞+9装备一件。\r现在可以进入最后一层了。");
}

// 标记为危险区域（有怪物）
danger = true;

// 设置当前地图名称
_root.nowmap = "地下城2层";

// 设置角色X坐标位置
renwu._x = 140;

// 设置角色Y坐标位置
renwu._y = 470;
