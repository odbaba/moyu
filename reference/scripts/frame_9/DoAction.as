// ============================================================
// frame_9/DoAction.as - 皇宫地图场景
// ============================================================
// 功能说明：
// 本文件是皇宫地图的场景初始化脚本
// 皇宫是游戏的主要安全区域，可以与国王、公主等NPC交互
// 
// 主要功能：
// 1. 设置角色位置
// 2. 标记为安全区域（danger = false 表示无怪物）
// 
// 场景设置：
// - renwu: MovieClip - 角色显示对象
// - renwu._x = 345 - 角色X坐标
// - renwu._y = 333 - 角色Y坐标
// 
// 地图属性：
// - 地图名称：皇宫
// - 地图类型：安全区域（无怪物）
// - danger = false - 标记为安全区域
// 
// 调用关系：
// - 可从雷鸣大陆等地图切换到此地图
// 
// 相关NPC：
// - 国王：主线剧情相关
// - 公主：关系系统、礼物系统
// - 元帅：军衔系统、军饷领取
// 
// 相关文件：
// - frame_6/DoAction.as - 核心游戏逻辑
// - DefineSprite_1071 - 地图切换按钮
// ============================================================

stop();

// 设置角色X坐标位置
renwu._x = 345;

// 设置角色Y坐标位置
renwu._y = 333;

// 标记为安全区域（无怪物）
danger = false;
