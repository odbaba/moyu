// ============================================================
// frame_30/DoAction.as - 地下城3层地图场景
// ============================================================
// 功能说明：
// 本文件是地下城3层地图的场景初始化脚本
// 地下城3层是地下城的最深层，有最终BOSS和丰厚奖励
// 
// 主要功能：
// 1. 设置角色位置
// 2. 标记为危险区域（danger = true 表示有怪物）
// 3. 设置当前地图名称
// 4. 检查并完成地下城3层任务
// 5. 触发救出国王剧情
// 
// 场景设置：
// - renwu: MovieClip - 角色显示对象
// - renwu._x = 340 - 角色X坐标
// - renwu._y = 335 - 角色Y坐标
// 
// 地图属性：
// - 地图名称：地下城3层
// - 地图类型：危险区域（有最终BOSS）
// - danger = true - 标记为危险区域
// 
// 任务系统：
// - 当地下城3层怪物任务完成时，给予奖励
// - 奖励：12000功勋 + 极品一洞+12装备一件 + 特殊道具
// - 特殊道具：战魂之心（已开启战魂系统）或月光宝盒增强版
// - 完成后触发救出国王剧情
// 
// 任务变量：
// - rw_gw3_1: 地下城3层怪物任务
// 
// 剧情触发：
// - 完成任务后调用 TouchStory() 触发救出国王剧情
// 
// 相关文件：
// - frame_6/DoAction.as - 核心游戏逻辑
// - frame_28/DoAction.as - 地下城1层
// - frame_29/DoAction.as - 地下城2层
// ============================================================

stop();

// 检查是否完成地下城3层任务
if(!rw_gw3_1 && _root.nowmap == "地下城3层")
{
   // 所有怪物已击败，给予奖励
   var exps = 12000;
   
   // 增加功勋值
   _root.xinxi.upjw(exps);
   
   // 根据是否开启战魂系统给予不同道具
   if(_root.openzh)
   {
      // 已开启战魂系统，奖励战魂之心
      id = "战魂之心";
   }
   else
   {
      // 未开启战魂系统，奖励月光宝盒增强版
      id = "月光宝盒增强版";
   }
   
   // 添加道具到背包
   _root.beibao.more(this);
   
   // 显示完成提示
   _root.alertbox("\r你完成任务了。：获得了12,000功勋、极品一洞+12装备一件和" + id);
   
   // 生成极品一洞+12装备
   weapon(4,12,1);
   
   // 触发救出国王剧情
   TouchStory();
}

// 标记为危险区域（有怪物）
danger = true;

// 设置当前地图名称
_root.nowmap = "地下城3层";

// 设置角色X坐标位置
renwu._x = 340;

// 设置角色Y坐标位置
renwu._y = 335;
