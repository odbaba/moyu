// ============================================================
// frame_7/DoAction.as - 读取存档界面
// ============================================================
// 功能说明：
// 本文件负责处理存档读取逻辑
// 
// 主要功能：
// 1. 检查是否需要读取存档
// 2. 如果需要读取，调用存档系统加载游戏数据
// 3. 显示加载完成提示
// 4. 如果不需要读取，继续播放时间轴
// 
// 调用关系：
// - 被 frame_6 调用（当 _root.laoddata 为 true 时）
// - 调用 _root.saveload.loadgame() 加载存档
// - 调用 _root.loadgamedata.openme() 显示加载完成提示
// 
// 全局变量：
// - _root.laoddata: Boolean - 是否需要读取存档
// 
// 流程说明：
// 1. 如果 _root.laoddata 为 true，执行存档读取
// 2. 读取完成后，将 _root.laoddata 设置为 false
// 3. 显示加载完成提示界面
// 4. 如果 _root.laoddata 为 false，继续播放时间轴
// ============================================================

stop();

// 检查是否需要读取存档
if(_root.laoddata)
{
   // 调用存档系统加载游戏数据
   _root.saveload.loadgame();
   
   // 标记存档读取完成
   _root.laoddata = false;
   
   // 显示加载完成提示界面
   _root.loadgamedata.openme();
}
else
{
   // 不需要读取存档，继续播放时间轴
   play();
}
